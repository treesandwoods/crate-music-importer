#!/bin/sh
set -eu
export PYTHONDONTWRITEBYTECODE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
if [ -n "${CRATE_PYTHON:-}" ]; then
    python_bin="$CRATE_PYTHON"
elif [ -x "$script_dir/.venv/bin/python3" ]; then
    python_bin="$script_dir/.venv/bin/python3"
elif [ -x "$HOME/Library/Application Support/Crate Music Importer/venv/bin/python3" ]; then
    python_bin="$HOME/Library/Application Support/Crate Music Importer/venv/bin/python3"
else
    python_bin=$(command -v python3)
fi
cd "$script_dir"
if [ "$#" -eq 1 ]; then
    case "$1" in http://*|https://*) set -- preview "$1" ;; esac
fi
exec "$python_bin" -m crate_music_importer.ipod_import "$@"
